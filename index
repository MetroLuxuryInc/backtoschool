<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Metro Luxury Back to School Promo</title>

  <style>
    :root{
      --blue:#169fe3;
      --blue2:#0f7fc4;
      --navy:#062f54;
      --navy2:#031f38;
      --light:#eef7fd;
      --white:#ffffff;
      --text:#0b2340;
      --border:#cfe5f5;
      --yellow:#ffd43b;
    }

    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      background:#dfeef8;
      color:var(--text);
    }

    .page{
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:flex-start;
      padding:24px;
    }

    .flyer{
      width:100%;
      max-width:920px;
      background:#fff;
      border-radius:24px;
      overflow:hidden;
      box-shadow:0 18px 50px rgba(0,0,0,.18);
    }

    .top{
      background:
        linear-gradient(135deg, rgba(255,255,255,.98), rgba(237,248,255,.97));
      padding:28px 30px 18px;
    }

    .brand-row{
      display:flex;
      align-items:center;
      gap:18px;
    }

    .logo{
      width:120px;
      max-width:28vw;
    }

    .brand-text h1{
      margin:0;
      font-size:34px;
      color:var(--navy);
      letter-spacing:.5px;
    }

    .brand-text p{
      margin:4px 0 0;
      color:var(--blue2);
      font-weight:700;
      font-size:15px;
    }

    .hero{
      margin-top:22px;
      display:grid;
      grid-template-columns:1.4fr .8fr;
      gap:22px;
      align-items:center;
    }

    .hero h2{
      margin:0;
      font-size:68px;
      line-height:.9;
      color:var(--navy);
      text-transform:uppercase;
      letter-spacing:-2px;
    }

    .hero h2 span{
      color:var(--blue);
    }

    .hero p{
      margin:18px 0 0;
      font-size:20px;
      color:#223b54;
      line-height:1.4;
    }

    .school-badge{
      background:var(--navy);
      color:white;
      padding:26px;
      border-radius:24px;
      text-align:center;
      transform:rotate(-2deg);
      box-shadow:0 10px 22px rgba(0,0,0,.15);
    }

    .school-badge .small{
      font-size:22px;
      font-weight:800;
      display:block;
    }

    .school-badge .big{
      font-size:44px;
      color:var(--blue);
      font-weight:900;
      line-height:1;
      display:block;
      margin:4px 0;
    }

    .school-badge .promo{
      font-size:24px;
      font-weight:900;
    }

    .base-fee{
      background:linear-gradient(90deg,var(--blue2),var(--blue));
      color:white;
      padding:26px 30px;
    }

    .base-fee .label{
      font-size:20px;
      font-weight:800;
      text-transform:uppercase;
      margin-bottom:6px;
    }

    .base-fee .main{
      display:flex;
      align-items:flex-end;
      gap:14px;
      flex-wrap:wrap;
    }

    .base-fee .zero{
      font-size:74px;
      font-weight:900;
      line-height:.9;
    }

    .base-fee .fee-text{
      font-size:48px;
      font-weight:900;
      line-height:.9;
    }

    .base-fee .days{
      margin-top:12px;
      font-size:22px;
      font-weight:800;
    }

    .base-fee .days span{
      color:var(--yellow);
    }

    .qualify{
      background:#f7fbfe;
      padding:24px 30px 8px;
    }

    .qualify-box{
      border:3px solid var(--blue);
      border-radius:20px;
      padding:20px 24px;
      background:white;
      text-align:center;
    }

    .qualify-box h3{
      margin:0;
      color:var(--navy);
      font-size:26px;
      text-transform:uppercase;
    }

    .qualify-box p{
      margin:10px auto 0;
      max-width:720px;
      font-size:19px;
      line-height:1.45;
    }

    .qualify-box strong{
      color:var(--blue2);
    }

    .pay-section{
      padding:26px 30px;
      background:white;
    }

    .pay-section h3{
      text-align:center;
      margin:0 0 20px;
      font-size:32px;
      color:var(--navy);
      text-transform:uppercase;
    }

    .pay-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:20px;
    }

    .pay-card{
      border:2px solid var(--border);
      border-radius:20px;
      padding:24px;
      text-align:center;
      background:#fbfdff;
    }

    .circle{
      width:84px;
      height:84px;
      margin:0 auto 14px;
      border-radius:50%;
      background:linear-gradient(135deg,var(--blue),var(--blue2));
      color:white;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:28px;
      font-weight:900;
    }

    .pay-card h4{
      margin:0;
      font-size:28px;
      color:var(--blue2);
      text-transform:uppercase;
    }

    .trip-count{
      display:inline-block;
      margin:12px 0;
      padding:10px 18px;
      background:var(--navy);
      color:white;
      border-radius:10px;
      font-size:30px;
      font-weight:900;
    }

    .pay-card p{
      margin:4px auto 0;
      max-width:300px;
      font-size:17px;
      line-height:1.45;
    }

    .pay-card p strong{
      color:var(--navy);
    }

    .gps{
      margin:0 30px 26px;
      background:var(--navy);
      color:white;
      border-radius:20px;
      padding:24px;
    }

    .gps h3{
      margin:0 0 10px;
      font-size:30px;
      color:white;
      text-transform:uppercase;
    }

    .gps h3 span{
      color:var(--blue);
    }

    .gps .important{
      font-weight:900;
      font-size:19px;
    }

    .gps .important span{
      color:var(--yellow);
    }

    .gps p{
      margin:6px 0;
      line-height:1.5;
      font-size:16px;
    }

    .gps-events{
      margin-top:18px;
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:12px;
    }

    .gps-event{
      border:1px solid rgba(255,255,255,.3);
      border-radius:14px;
      padding:14px 10px;
      text-align:center;
      font-weight:800;
      font-size:16px;
    }

    .cta{
      background:linear-gradient(90deg,var(--blue2),var(--blue));
      color:white;
      padding:28px 30px;
      text-align:center;
    }

    .cta h3{
      margin:0;
      font-size:40px;
      text-transform:uppercase;
    }

    .cta p{
      margin:8px 0 18px;
      font-size:18px;
    }

    .cta a{
      display:inline-block;
      padding:16px 30px;
      background:white;
      color:var(--navy);
      text-decoration:none;
      font-weight:900;
      font-size:19px;
      border-radius:999px;
    }

    .benefits{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      background:var(--navy2);
      color:white;
      text-align:center;
      border-top:1px solid rgba(255,255,255,.15);
    }

    .benefit{
      padding:20px 14px;
      font-weight:800;
      font-size:16px;
    }

    .footer{
      background:#031a2e;
      color:#d9e8f5;
      padding:18px 24px;
      font-size:12px;
      line-height:1.5;
      text-align:center;
    }

    @media(max-width:760px){
      .page{
        padding:0;
      }

      .flyer{
        border-radius:0;
      }

      .brand-row{
        align-items:flex-start;
      }

      .brand-text h1{
        font-size:24px;
      }

      .hero{
        grid-template-columns:1fr;
      }

      .hero h2{
        font-size:48px;
      }

      .school-badge{
        transform:none;
      }

      .pay-grid{
        grid-template-columns:1fr;
      }

      .gps-events{
        grid-template-columns:1fr;
      }

      .benefits{
        grid-template-columns:1fr;
      }

      .base-fee .fee-text{
        font-size:38px;
      }
    }
  </style>
</head>

<body>

<div class="page">
  <div class="flyer">

    <section class="top">

      <div class="brand-row">

        <!--
        Put your Metro logo file in the same GitHub folder as index.html
        and name it:
        metro-logo.png
        -->

        <img
          src="metro-logo.png"
          alt="Metro Luxury Logo"
          class="logo"
        >

        <div class="brand-text">
          <h1>METRO LUXURY INC.</h1>
          <p>MORE THAN TRANSPORTATION, PARTNERS IN YOUR HEALTH.</p>
        </div>

      </div>

      <div class="hero">

        <div>
          <h2>
            COME BACK<br>
            <span>& DRIVE</span>
          </h2>

          <p>
            Get back on the road with Metro Luxury
            and start earning again.
          </p>
        </div>

        <div class="school-badge">
          <span class="small">BACK TO</span>
          <span class="big">SCHOOL</span>
          <span class="promo">PROMO</span>
        </div>

      </div>

    </section>


    <section class="base-fee">

      <div class="label">
        Returning Driver Special
      </div>

      <div class="main">
        <div class="zero">$0</div>
        <div class="fee-text">BASE FEE</div>
      </div>

      <div class="days">
        FOR YOUR FIRST <span>30 DAYS</span> BACK
      </div>

    </section>


    <section class="qualify">

      <div class="qualify-box">

        <h3>
          Minimum Trips Required to Qualify for No Base Fee
        </h3>

        <p>
          To receive and maintain the <strong>$0 base fee promotion</strong>,
          you must meet the minimum completed-trip requirement based on
          your selected payment option.
        </p>

      </div>

    </section>


    <section class="pay-section">

      <h3>
        Choose How You Get Paid
      </h3>

      <div class="pay-grid">

        <div class="pay-card">

          <div class="circle">
            25
          </div>

          <h4>
            Weekly Pay
          </h4>

          <div class="trip-count">
            25 TRIPS
          </div>

          <p>
            Complete a minimum of
            <strong>25 completed trips</strong>
            to qualify for weekly pay
            <strong>and the $0 base fee promotion.</strong>
          </p>

        </div>


        <div class="pay-card">

          <div class="circle">
            5
          </div>

          <h4>
            Next Day Pay
          </h4>

          <div class="trip-count">
            5 TRIPS
          </div>

          <p>
            Complete a minimum of
            <strong>5 completed trips</strong>
            to qualify for next day pay
            <strong>and the $0 base fee promotion.</strong>
          </p>

        </div>

      </div>

    </section>


    <section class="gps">

      <h3>
        <span>GPS</span> Compliance Required
      </h3>

      <div class="important">
        ALL TRIPS MUST BE <span>GPS COMPLIANT.</span>
      </div>

      <p>
        Drivers must properly complete all required GPS trip events.
      </p>

      <div class="gps-events">

        <div class="gps-event">
          ON LOCATION
        </div>

        <div class="gps-event">
          PICKUP
        </div>

        <div class="gps-event">
          DROP OFF
        </div>

      </div>

    </section>


    <section class="cta">

      <h3>
        Ready to Come Back?
      </h3>

      <p>
        Get back on the road with Metro Luxury.
      </p>

      <!-- Replace # with your actual driver link -->
      <a href="#">
        START DRIVING TODAY
      </a>

    </section>


    <section class="benefits">

      <div class="benefit">
        GREAT EARNINGS
      </div>

      <div class="benefit">
        SUPPORT YOU CAN COUNT ON
      </div>

      <div class="benefit">
        FLEXIBLE SCHEDULES
      </div>

    </section>


    <footer class="footer">

      Limited-time promotion. Terms and conditions apply.
      Eligible completed trips must meet applicable GPS compliance requirements.
      Minimum trip requirements apply to qualify for and maintain the no base fee promotion.
      Metro Luxury Inc. reserves the right to modify or discontinue this promotion at any time.

    </footer>

  </div>
</div>

</body>
</html>
